# Скопируйте этот файл в backend/.env и вставьте ссылку из кнопки «Открыть GET для DEV»
# (CQA_Hackathon_Student_Guide, стр. 3). Параметр group_id в конце можно не указывать — сервер подставит его сам.
CQA_API_URL=https://<адрес-из-гайда>/invoke?api-version=1&sp=...&sv=1.0&sig=...

# Ключ Anthropic API для модуля оценки (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...
# Модель и глубина рассуждений (необязательно)
# CQA_MODEL=claude-opus-5-5
# CQA_EFFORT=high

# PORT=3000
# CQA_GROUP_ID=DEV
